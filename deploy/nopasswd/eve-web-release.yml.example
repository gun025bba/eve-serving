# Copy to gun025bba/eve-web/.github/workflows/release.yml (the UI repo). Tag a commit on main as vX.Y.Z -> a CI-signed UI bundle is
# published, which the Mac installs with:  /usr/local/libexec/eve/fetch web X.Y.Z && sudo /usr/local/libexec/eve/deploy deploy-web
# The signing workflow is the one in the gateway repo (single trust root); eve-web only calls it.
name: release
on:
  push:
    tags: ["v[0-9]+.[0-9]+.[0-9]+"]
permissions:
  contents: read
jobs:
  web:
    permissions:
      contents: write
      id-token: write
    uses: gun025bba/eve-serving/.github/workflows/deploy-sign.yml@main
    with:
      kind: web
