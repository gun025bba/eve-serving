#!/bin/bash
# Downloads the three files of a CI-signed release into the staging dir. Run as the deploy user (NO sudo, no secrets, no keys):
#   /usr/local/libexec/eve/fetch gateway 5.0.2 && sudo /usr/local/libexec/eve/deploy deploy 5.0.2
#   /usr/local/libexec/eve/fetch web 1.10.0    && sudo /usr/local/libexec/eve/deploy deploy-web 1.10.0
# Nothing downloaded here is trusted: the root entrypoint copies the files and verifies the signature, the pinned CI identity,
# the version, the commit's branch and every sha256 before it installs anything. A wrong or hostile download can only make the deploy fail.
# Installed at /usr/local/libexec/eve/fetch (root:wheel 0755). Written for macOS /bin/bash 3.2.
# shellcheck disable=SC2015  # "A && B || die" is intended: die on any failure
set -Eeuo pipefail
export PATH=/usr/bin:/bin
die() { echo "fetch: $*" >&2; exit 1; }
STAGING=${EVE_FETCH_STAGING:-/usr/local/libexec/eve/staging}    # EVE_FETCH_* exist for the tests; this script never runs as root
BASE=${EVE_FETCH_BASE:-https://github.com}
PROTO=${EVE_FETCH_PROTO:-=https}
[ "$(id -u)" != 0 ] || die "run as your own user (no sudo): the staging dir belongs to the deploy user"
[ $# -eq 2 ] || die "usage: fetch gateway|web X.Y.Z"
KIND=$1 VER=$2
case "$KIND" in gateway) REPO=gun025bba/eve-serving;; web) REPO=gun025bba/eve-web;; *) die "kind must be gateway or web";; esac
[[ "$VER" =~ ^(0|[1-9][0-9]{0,8})\.(0|[1-9][0-9]{0,8})\.(0|[1-9][0-9]{0,8})$ ]] || die "version must be X.Y.Z"
[ -d "$STAGING" ] && [ ! -L "$STAGING" ] && [ -w "$STAGING" ] || die "staging dir $STAGING is missing or not yours (run the one-time install first)"
N=eve-$KIND-$VER
TMP=$(mktemp -d "$STAGING/.fetch.XXXXXX"); trap 'rm -rf "$TMP"' EXIT
for f in "$N.MANIFEST" "$N.sigstore.json" "$N.tar"; do
  curl -fsSL --proto "$PROTO" --tlsv1.2 --retry 3 --max-time 600 --max-filesize 629145600 -o "$TMP/$f" "$BASE/$REPO/releases/download/v$VER/$f" || die "download failed: $f (is v$VER released?)"
  [ -s "$TMP/$f" ] || die "empty download: $f"
done
rm -f "$STAGING/$N.MANIFEST" "$STAGING/$N.sigstore.json" "$STAGING/$N.tar"
mv "$TMP/$N.tar" "$STAGING/$N.tar" && mv "$TMP/$N.sigstore.json" "$STAGING/$N.sigstore.json" && mv "$TMP/$N.MANIFEST" "$STAGING/$N.MANIFEST"
echo "staged $N (unverified until the deploy runs):"
case "$KIND" in gateway) echo "  sudo /usr/local/libexec/eve/deploy deploy $VER";; web) echo "  sudo /usr/local/libexec/eve/deploy deploy-web $VER";; esac
