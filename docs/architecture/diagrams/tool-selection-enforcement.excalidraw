  {
   "id": "tool-selection-enforcement-34",
   "type": "text",
   "x": 1574,
   "y": 386.4,
   "width": 552,
   "height": 100.0,
   "angle": 0,
   "strokeColor": "#333",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
