{
  "openapi": "3.0.3",
  "info": {
    "title": "Local LLM Gateway",
    "version": "3.0-go",
    "description": "OpenAI-compatible gateway in front of mlx_lm.server. Auth: `Authorization: Bearer <key>`. Errors use OpenAI format `{error:{message,type,code,request_id}}`. Codes: invalid_api_key 401, bad_request 400, queue_full/queue_timeout 429, upstream_unavailable 503, upstream_timeout 504, upstream_error 502, internal_error 500. Every response carries `X-Request-ID`."
  },
  "tags": [
    {
      "name": "inference",
      "description": "OpenAI-compatible endpoints (Bearer auth)"
    },
    {
      "name": "ops",
      "description": "Health, readiness, metrics (no auth)"
    },
    {
      "name": "admin",
      "description": "Runtime admin (Bearer auth)"
    },
    {
      "name": "threads",
      "description": "Conversation storage (PostgreSQL). 503 persistence_disabled when no database. See docs/threads-api.md"
    }
  ],
  "components": {
    "securitySchemes": {
      "bearer": {
        "type": "http",
        "scheme": "bearer",
        "description": "API key from ~/llm-serving/.api_key"
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "message": {
                "type": "string"
              },
              "type": {
                "type": "string"
              },
              "code": {
                "type": "string"
              },
              "request_id": {
                "type": "string"
              }
            }
          }
        }
      },
      "ChatRequest": {
        "type": "object",
        "required": [
          "messages"
        ],
        "additionalProperties": true,
        "properties": {
          "model": {
            "type": "string"
          },
          "messages": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "properties": {
                "role": {
                  "type": "string"
                },
                "content": {
                  "type": "string"
                }
              }
            }
          },
          "max_tokens": {
            "type": "integer",
            "description": "default from config (1024)"
          },
          "temperature": {
            "type": "number"
          },
          "top_p": {
            "type": "number"
          },
          "stream": {
            "type": "boolean"
          },
          "stream_options": {
            "type": "object"
          },
          "thread_id": {
            "type": "string",
            "description": "Persist to this thread, or \"new\". Stripped before upstream. Response: X-Thread-Id/X-Message-Id/X-User-Message-Id headers + thread_id/message_id/user_message_id body fields; stream: first chunk has thread_id+user_message_id, final event object=chat.completion.persisted before [DONE]."
          },
          "replace_message_id": {
            "type": "string",
            "description": "Regenerate: overwrite this assistant message (same id, feedback cleared, no new user message). Requires thread_id."
          },
          "web_search": {
            "description": "Web tools for this request: false/\"off\", true/\"auto\" (model decides), \"force\" (gateway searches first). Omitted = thread setting, then server default. 400 web_search_disabled when the server has web off. Streaming adds events chat.completion.tool_call, chat.completion.tool_result and chat.completion.sources (before chat.completion.persisted); non-streaming adds choices[0].message.sources.",
            "oneOf": [
              {
                "type": "boolean"
              },
              {
                "type": "string",
                "enum": [
                  "off",
                  "auto",
                  "force"
                ]
              }
            ]
          }
        },
        "example": {
          "messages": [
            {
              "role": "user",
              "content": "안녕"
            }
          ],
          "max_tokens": 64,
          "stream": false
        }
      },
      "Thread": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          },
          "archived": {
            "type": "boolean"
          },
          "message_count": {
            "type": "integer"
          },
          "last_message_preview": {
            "type": "string",
            "nullable": true
          },
          "client_id": {
            "type": "string"
          }
        }
      },
      "Feedback": {
        "type": "object",
        "properties": {
          "message_id": {
            "type": "string"
          },
          "rating": {
            "type": "string",
            "enum": [
              "up",
              "down"
            ]
          },
          "comment": {
            "type": "string",
            "nullable": true
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "Message": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "thread_id": {
            "type": "string"
          },
          "role": {
            "type": "string",
            "enum": [
              "user",
              "assistant",
              "system",
              "tool"
            ]
          },
          "content": {
            "type": "string"
          },
          "reasoning": {
            "type": "string"
          },
          "model": {
            "type": "string"
          },
          "params": {
            "type": "object"
          },
          "usage": {
            "type": "object",
            "properties": {
              "prompt_tokens": {
                "type": "integer"
              },
              "completion_tokens": {
                "type": "integer"
              }
            }
          },
          "latency_ms": {
            "type": "integer"
          },
          "metadata": {
            "type": "object"
          },
          "status": {
            "type": "string",
            "enum": [
              "complete",
              "incomplete"
            ]
          },
          "client_id": {
            "type": "string"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          },
          "feedback": {
            "$ref": "#/components/schemas/Feedback"
          }
        }
      },
      "SearchHit": {
        "type": "object",
        "properties": {
          "thread_id": {
            "type": "string"
          },
          "thread_title": {
            "type": "string"
          },
          "message_id": {
            "type": "string",
            "nullable": true
          },
          "role": {
            "type": "string",
            "nullable": true
          },
          "snippet": {
            "type": "string",
            "description": "HTML-escaped; only <mark> tags"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "match": {
            "type": "string",
            "enum": [
              "title",
              "content"
            ]
          }
        }
      },
      "ImportRequest": {
        "type": "object",
        "required": [
          "threads"
        ],
        "properties": {
          "threads": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "client_id",
                "created_at"
              ],
              "properties": {
                "client_id": {
                  "type": "string"
                },
                "title": {
                  "type": "string"
                },
                "created_at": {
                  "type": "string",
                  "format": "date-time"
                },
                "archived": {
                  "type": "boolean"
                },
                "messages": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": [
                      "role",
                      "content",
                      "created_at"
                    ],
                    "properties": {
                      "client_id": {
                        "type": "string"
                      },
                      "role": {
                        "type": "string"
                      },
                      "content": {
                        "type": "string"
                      },
                      "reasoning": {
                        "type": "string"
                      },
                      "model": {
                        "type": "string"
                      },
                      "created_at": {
                        "type": "string",
                        "format": "date-time"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      },
      "WebSource": {
        "type": "object",
        "properties": {
          "n": {
            "type": "integer"
          },
          "url": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "domain": {
            "type": "string"
          },
          "fetched": {
            "type": "boolean"
          },
          "cited": {
            "type": "boolean"
          }
        }
      }
    }
  },
  "paths": {
    "/v1/chat/completions": {
      "post": {
        "tags": [
          "inference"
        ],
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Chat completion (OpenAI-compatible, supports stream=true SSE)",
        "description": "Omitted max_tokens/temperature/top_p/model get config defaults. With `stream: true` returns `text/event-stream`: lines `data: {chat.completion.chunk JSON}` ending with `data: [DONE]`. Mid-stream failures emit `data: {\"error\":{...}}` then `data: [DONE]`.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ChatRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "chat.completion JSON or SSE stream"
          },
          "400": {
            "description": "bad_request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "invalid_api_key",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "generation_in_progress (same user turn already being answered, or regenerating a generating message)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "queue_full | queue_timeout",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "internal_error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "502": {
            "description": "upstream_error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "upstream_unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "504": {
            "description": "upstream_timeout",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/models": {
      "get": {
        "tags": [
          "inference"
        ],
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "List models",
        "responses": {
          "200": {
            "description": "model list"
          },
          "401": {
            "description": "invalid_api_key",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "502": {
            "description": "upstream_error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "upstream_unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "504": {
            "description": "upstream_timeout",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/health": {
      "get": {
        "tags": [
          "ops"
        ],
        "summary": "Liveness: gateway process is up (no upstream check)",
        "responses": {
          "200": {
            "description": "ok"
          }
        }
      }
    },
    "/ready": {
      "get": {
        "tags": [
          "ops"
        ],
        "summary": "Readiness: upstream reachable, model loaded, memory headroom",
        "responses": {
          "200": {
            "description": "ready"
          },
          "503": {
            "description": "not ready"
          }
        }
      }
    },
    "/metrics": {
      "get": {
        "tags": [
          "ops"
        ],
        "summary": "Prometheus metrics (text exposition)",
        "responses": {
          "200": {
            "description": "text/plain"
          }
        }
      }
    },
    "/stats": {
      "get": {
        "tags": [
          "ops"
        ],
        "summary": "Human-readable summary over the recent request window",
        "responses": {
          "200": {
            "description": "JSON"
          }
        }
      }
    },
    "/admin/config": {
      "get": {
        "tags": [
          "admin"
        ],
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Effective config (no secrets)",
        "responses": {
          "200": {
            "description": "config"
          },
          "401": {
            "description": "invalid_api_key",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/admin/log-level": {
      "post": {
        "tags": [
          "admin"
        ],
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Change log level at runtime (DEBUG/INFO/WARNING/ERROR)",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "level": {
                    "type": "string",
                    "enum": [
                      "DEBUG",
                      "INFO",
                      "WARNING",
                      "ERROR"
                    ]
                  }
                }
              },
              "example": {
                "level": "DEBUG"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "new level"
          },
          "400": {
            "description": "bad_request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "invalid_api_key",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/whoami": {
      "get": {
        "summary": "Caller identity (provider + user). 401 codes: unauthenticated, invalid_api_key; 403: identity_not_allowed",
        "responses": {
          "200": {
            "description": "{authenticated, user, provider}"
          },
          "401": {
            "description": "Not authenticated"
          }
        }
      }
    },
    "/v1/me": {
      "get": {
        "summary": "Caller identity (provider + user). 401 codes: unauthenticated, invalid_api_key; 403: identity_not_allowed",
        "responses": {
          "200": {
            "description": "{authenticated, user, provider}"
          },
          "401": {
            "description": "Not authenticated"
          }
        }
      }
    },
    "/v1/threads": {
      "get": {
        "tags": [
          "threads"
        ],
        "summary": "List threads (updated_at desc, keyset cursor)",
        "security": [
          {
            "bearer": []
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Thread"
                      }
                    },
                    "next_cursor": {
                      "type": "string",
                      "nullable": true
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Not authenticated",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "persistence_disabled",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer"
            },
            "description": "1-100, default 20"
          },
          {
            "name": "cursor",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": ""
          },
          {
            "name": "archived",
            "in": "query",
            "schema": {
              "type": "boolean"
            },
            "description": "default false"
          }
        ]
      },
      "post": {
        "tags": [
          "threads"
        ],
        "summary": "Create thread",
        "security": [
          {
            "bearer": []
          }
        ],
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Thread"
                }
              }
            }
          },
          "401": {
            "description": "Not authenticated",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "persistence_disabled",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "title": {
                    "type": "string"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/v1/threads/import": {
      "post": {
        "tags": [
          "threads"
        ],
        "summary": "Import local threads (idempotent per client_id, max 5 MB)",
        "security": [
          {
            "bearer": []
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "results": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "client_id": {
                            "type": "string"
                          },
                          "thread_id": {
                            "type": "string"
                          },
                          "status": {
                            "type": "string",
                            "enum": [
                              "created",
                              "exists"
                            ]
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Not authenticated",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "persistence_disabled",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "400": {
            "description": "bad_request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "413": {
            "description": "payload_too_large",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ImportRequest"
              }
            }
          }
        }
      }
    },
    "/v1/threads/{id}": {
      "get": {
        "tags": [
          "threads"
        ],
        "summary": "Get thread",
        "security": [
          {
            "bearer": []
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Thread"
                }
              }
            }
          },
          "401": {
            "description": "Not authenticated",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "persistence_disabled",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "not_found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ]
      },
      "patch": {
        "tags": [
          "threads"
        ],
        "summary": "Rename / archive / unarchive",
        "security": [
          {
            "bearer": []
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Thread"
                }
              }
            }
          },
          "401": {
            "description": "Not authenticated",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "persistence_disabled",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "not_found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "title": {
                    "type": "string"
                  },
                  "archived": {
                    "type": "boolean"
                  }
                }
              }
